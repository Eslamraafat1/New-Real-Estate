# Copy to .env.local and fill in what you need. Every variable is optional:
# with nothing set the app serves bundled demo data.

# Canonical origin for metadata, hreflang, sitemap.xml and robots.txt.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then https://new-real-estate-jade.vercel.app
NEXT_PUBLIC_SITE_URL=

# Default display currency (ISO 4217)
NEXT_PUBLIC_CURRENCY=USD

# Map provider switch ("demo" renders the bundled SVG map)
NEXT_PUBLIC_MAP_PROVIDER=demo

# Data source: "demo" (default) or "remote" (proxies to BACKEND_API_URL)
DATA_SOURCE=demo

# Server-only — never prefix these with NEXT_PUBLIC_
BACKEND_API_URL=
BACKEND_API_KEY=
INQUIRY_WEBHOOK_URL=
